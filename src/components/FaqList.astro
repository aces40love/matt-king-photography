---
import SectionIntro from './SectionIntro.astro';

interface Faq {
  question: string;
  answer: string;
}

interface Props {
  faqs: Faq[];
  title?: string;
  copy?: string;
}

const {
  faqs,
  title = 'Good questions, answered plainly.',
  copy = 'The important details should be clear before you decide to book.',
} = Astro.props;
---

<section class="section faq-section">
  <div class="container faq-layout">
    <SectionIntro eyebrow="Before we begin" title={title} copy={copy} />
    <div class="faq-list">
      {faqs.map((faq) => (
        <details>
          <summary>{faq.question}<span aria-hidden="true"></span></summary>
          <div><p>{faq.answer}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
