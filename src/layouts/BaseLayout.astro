---
import '@fontsource-variable/manrope';
import '@fontsource-variable/newsreader';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { withBase } from '../utils/sitePath';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  image = '/og-image.jpg',
  imageAlt = 'A family portrait by Matt King Photography',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const siteRoot = new URL(withBase('/'), Astro.site);
const socialImage = new URL(withBase(image), Astro.site);
const fullAddress = {
  '@type': 'PostalAddress',
  streetAddress: site.address.street,
  addressLocality: site.address.city,
  addressRegion: site.address.region,
  postalCode: site.address.postalCode,
  addressCountry: 'US',
};

const schema = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'ProfessionalService'],
  '@id': `${siteRoot.toString()}#business`,
  name: site.name,
  url: siteRoot.toString(),
  logo: new URL(withBase('/favicon.svg'), Astro.site).toString(),
  image: socialImage.toString(),
  telephone: '+19013593064',
  foundingDate: site.established,
  address: fullAddress,
  areaServed: [
    'Memphis, Tennessee',
    'Tipton County, Tennessee',
    'Shelby County, Tennessee',
    'Fayette County, Tennessee',
    'West Tennessee',
  ],
  sameAs: [site.social.instagram, site.social.facebook],
};
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f1ea" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={withBase('/site.webmanifest')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:image" content={socialImage.toString()} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.toString()} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
  </head>
  <body>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
