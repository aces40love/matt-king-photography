---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import FaqList from '../components/FaqList.astro';
import InquiryBand from '../components/InquiryBand.astro';
import Process from '../components/Process.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionIntro from '../components/SectionIntro.astro';
import Testimonials from '../components/Testimonials.astro';
import { commonFaqs } from '../data/site';
import { withBase } from '../utils/sitePath';

import heroFamily from '../assets/images/hero-family.webp';
import familyFive from '../assets/images/family-five.webp';
import familyMeadow from '../assets/images/family-meadow.webp';
import familyAutumn from '../assets/images/family-autumn.webp';
import childGirl from '../assets/images/child-girl.webp';
import childBoy from '../assets/images/child-boy.webp';
import childSisters from '../assets/images/child-sisters.webp';
import seniorHorse from '../assets/images/senior-horse.webp';
import seniorHat from '../assets/images/senior-hat.webp';
import seniorSuit from '../assets/images/senior-suit.webp';
import headshot from '../assets/images/headshot.png';
---

<BaseLayout
  title="Memphis Family Photographer | Matt King Photography"
  description="Relaxed family, child, and senior photography for Memphis and West Tennessee, with a private 10-acre property and custom artwork for your home."
>
  <section class="home-hero">
    <Image
      class="home-hero__image"
      src={heroFamily}
      alt="Parents sitting with their young daughter beside the water in West Tennessee"
      widths={[720, 1080, 1440, 1920]}
      sizes="100vw"
      format="webp"
      quality={86}
      loading="eager"
      fetchpriority="high"
    />
    <div class="home-hero__shade"></div>
    <div class="container home-hero__content">
      <p class="eyebrow eyebrow--light">Memphis &amp; West Tennessee portrait photographer</p>
      <h1>The years move fast. Your walls can hold them still.</h1>
      <p>Relaxed portraits, thoughtful guidance, and finished artwork made for the people you never want to forget.</p>
      <div class="button-row">
        <ButtonLink href="/contact/" label="Plan your session" variant="light" />
        <ButtonLink href="#sessions" label="Explore sessions" variant="text" />
      </div>
    </div>
    <p class="home-hero__caption">Private portrait property · Historic Downtown Munford</p>
  </section>

  <ProofBar />

  <section class="section opening-section">
    <div class="container opening-grid">
      <div>
        <p class="eyebrow">Frame-worthy. Family-proof.</p>
        <h2>Good photographs do not require perfectly behaved people.</h2>
      </div>
      <div class="opening-copy">
        <p class="lede">You bring the people you love. Matt brings two decades of patience, a plan for the details, and enough room for everyone to settle in.</p>
        <p>No guessing what to wear. No pressure to perform. No folder of files you intend to print someday. Just an easy experience that ends with portraits you can see and enjoy every day.</p>
        <ButtonLink href="/experience/" label="See how it works" variant="outline" />
      </div>
    </div>
  </section>

  <section class="section services-section" id="sessions">
    <div class="container">
      <SectionIntro
        eyebrow="Choose your story"
        title="Three seasons of life. One calm, personal experience."
        copy="Every session is planned around who you are now—not a generic location, pose list, or trend."
      />
      <div class="service-grid">
        <a href={withBase('/families/')} class="service-card">
          <Image src={familyFive} alt="Family of five standing together outdoors" widths={[480, 720, 960]} sizes="(max-width: 760px) 100vw, 33vw" format="webp" quality={82} loading="lazy" />
          <span class="service-card__shade"></span>
          <span class="service-card__content">
            <small>Connection over perfection</small>
            <strong>Families</strong>
            <em>Explore family sessions →</em>
          </span>
        </a>
        <a href={withBase('/children/')} class="service-card">
          <Image src={childGirl} alt="Young girl smiling during an outdoor portrait session" widths={[480, 720, 960]} sizes="(max-width: 760px) 100vw, 33vw" format="webp" quality={82} loading="lazy" />
          <span class="service-card__shade"></span>
          <span class="service-card__content">
            <small>Personality in full color</small>
            <strong>Children</strong>
            <em>Explore child sessions →</em>
          </span>
        </a>
        <a href={withBase('/seniors/')} class="service-card">
          <Image src={seniorHorse} alt="High school senior standing beside her horse" widths={[480, 720, 960]} sizes="(max-width: 760px) 100vw, 33vw" format="webp" quality={82} loading="lazy" />
          <span class="service-card__shade"></span>
          <span class="service-card__content">
            <small>Built around who they are</small>
            <strong>Seniors</strong>
            <em>Explore senior sessions →</em>
          </span>
        </a>
      </div>
    </div>
  </section>

  <section class="property-section">
    <div class="property-section__image">
      <Image src={familyMeadow} alt="Family with a toddler walking together through a meadow" widths={[720, 1080, 1440]} sizes="(max-width: 820px) 100vw, 52vw" format="webp" quality={84} loading="lazy" />
    </div>
    <div class="property-section__content">
      <p class="eyebrow eyebrow--light">Room to be yourselves</p>
      <h2>Ten private acres. No audience. No rush.</h2>
      <p>Wooded paths, open fields, changing light, and space for children to move make our outdoor portrait property feel less like a photo set and more like an afternoon together.</p>
      <p>Prefer something urban or personal? Sessions can also be designed around Historic Downtown Munford or a location that belongs to your story.</p>
      <ButtonLink href="/experience/" label="Discover the experience" variant="light" />
    </div>
  </section>

  <Process />

  <section class="section portfolio-section">
    <div class="container">
      <SectionIntro
        eyebrow="Recent favorites"
        title="Portraits that feel like the people in them."
        copy="Natural expression, unhurried connection, and enough direction that no one wonders what to do with their hands."
      />
      <div class="home-gallery">
        <figure class="home-gallery__family"><Image src={familyAutumn} alt="Family of three together in autumn light" widths={[640, 960, 1280]} sizes="(max-width: 760px) 100vw, 54vw" format="webp" quality={82} loading="lazy" /></figure>
        <figure><Image src={childBoy} alt="Young boy smiling outdoors during his portrait session" widths={[420, 640, 800]} sizes="(max-width: 760px) 100vw, 23vw" format="webp" quality={82} loading="lazy" /></figure>
        <figure><Image src={seniorHat} alt="High school senior wearing a wide-brim hat outdoors" widths={[420, 640, 800]} sizes="(max-width: 760px) 100vw, 23vw" format="webp" quality={82} loading="lazy" /></figure>
        <figure><Image src={childSisters} alt="Sisters standing close together during an outdoor portrait session" widths={[420, 640, 800]} sizes="(max-width: 760px) 100vw, 23vw" format="webp" quality={82} loading="lazy" /></figure>
        <figure><Image src={seniorSuit} alt="High school senior in a black suit photographed outdoors" widths={[420, 640, 800]} sizes="(max-width: 760px) 100vw, 23vw" format="webp" quality={82} loading="lazy" /></figure>
      </div>
    </div>
  </section>

  <section class="section artwork-section">
    <div class="container artwork-grid">
      <div class="artwork-copy">
        <p class="eyebrow">More than a camera roll</p>
        <h2>Your favorite people deserve a place in the room.</h2>
        <p class="lede">The experience does not stop when the camera is packed away.</p>
        <p>Matt helps you choose photographs that belong together and turn them into framed portraits, wall art, and heirloom pieces sized for your home. You can see the possibilities before deciding.</p>
        <ButtonLink href="/experience/#artwork" label="Explore finished artwork" variant="outline" />
      </div>
      <div class="wall-scene">
        <div class="wall-frame">
          <Image src={familyFive} alt="Family portrait displayed as framed wall art" widths={[480, 720, 960]} sizes="(max-width: 820px) 80vw, 38vw" format="webp" quality={82} loading="lazy" />
        </div>
        <div class="wall-console"><i></i><i></i></div>
      </div>
    </div>
  </section>

  <Testimonials />

  <section class="section about-preview">
    <div class="container about-preview__grid">
      <div class="about-preview__image">
        <Image src={headshot} alt="Matt King, Memphis and West Tennessee portrait photographer" widths={[440, 720, 960]} sizes="(max-width: 820px) 100vw, 42vw" format="webp" quality={82} loading="lazy" />
      </div>
      <div class="about-preview__content">
        <p class="eyebrow">Meet Matt</p>
        <h2>A father first. A photographer since 2004.</h2>
        <p class="lede">Matt knows the photographs parents wish they had made sooner—because he has watched his own three children grow up, too.</p>
        <p>His sessions are personal, practical, and rooted in service: listen well, keep children comfortable, guide every step, and make something meaningful for the family who trusted him.</p>
        <ButtonLink href="/about/" label="Get to know Matt" variant="outline" />
      </div>
    </div>
  </section>

  <FaqList faqs={commonFaqs} />
  <InquiryBand />
</BaseLayout>

<style>
  .home-hero {
    position: relative;
    min-height: min(54rem, calc(100svh - 7.75rem));
    overflow: hidden;
    color: white;
    background: #273127;
  }

  .home-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 45%;
  }

  .home-hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(16, 22, 17, 0.9) 0%, rgba(16, 22, 17, 0.66) 38%, rgba(16, 22, 17, 0.05) 72%), linear-gradient(0deg, rgba(0, 0, 0, 0.35), transparent 45%);
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    min-height: inherit;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding-block: 6rem;
  }

  .home-hero h1 {
    max-width: 10.5ch;
    font-size: clamp(4.2rem, 8vw, 7.6rem);
  }

  .home-hero__content > p:not(.eyebrow) {
    max-width: 36rem;
    margin-bottom: 2rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
  }

  .home-hero .button--text {
    color: white;
    border-bottom-color: rgba(255, 255, 255, 0.7);
  }

  .home-hero__caption {
    position: absolute;
    z-index: 2;
    right: var(--gutter);
    bottom: 1.4rem;
    margin: 0;
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .opening-section {
    background: var(--paper);
  }

  .opening-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    align-items: start;
    gap: clamp(3rem, 9vw, 9rem);
  }

  .opening-copy {
    padding-top: 2rem;
    color: var(--ink-soft);
  }

  .opening-copy .button {
    margin-top: 1.25rem;
  }

  .services-section {
    background: var(--cream);
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
  }

  .service-card {
    position: relative;
    min-height: clamp(32rem, 48vw, 43rem);
    overflow: hidden;
    color: white;
    background: var(--forest);
    text-decoration: none;
  }

  .service-card img,
  .service-card__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .service-card img {
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-card__shade {
    background: linear-gradient(0deg, rgba(12, 17, 13, 0.84), transparent 62%);
  }

  .service-card__content {
    position: absolute;
    z-index: 1;
    right: clamp(1.5rem, 3vw, 2.5rem);
    bottom: clamp(1.75rem, 3vw, 2.75rem);
    left: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
  }

  .service-card small {
    margin-bottom: 0.35rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.63rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .service-card strong {
    margin-bottom: 1rem;
    font-family: var(--serif);
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 430;
    line-height: 1;
  }

  .service-card em {
    font-size: 0.72rem;
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .service-card:hover img {
    transform: scale(1.035);
  }

  .property-section {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    min-height: 50rem;
    color: white;
    background: var(--forest);
  }

  .property-section__image {
    min-height: 42rem;
  }

  .property-section__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .property-section__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(4rem, 8vw, 8rem);
  }

  .property-section__content p:not(.eyebrow) {
    max-width: 34rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .property-section__content .button {
    margin-top: 1.2rem;
  }

  .portfolio-section {
    background: var(--cream);
  }

  .home-gallery {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr 0.85fr;
    grid-template-rows: repeat(2, clamp(18rem, 27vw, 28rem));
    gap: 0.75rem;
  }

  .home-gallery figure {
    margin: 0;
    overflow: hidden;
  }

  .home-gallery__family {
    grid-row: span 2;
  }

  .home-gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .home-gallery figure:hover img {
    transform: scale(1.025);
  }

  .artwork-section {
    background: var(--paper);
  }

  .artwork-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    align-items: center;
    gap: clamp(3rem, 9vw, 9rem);
  }

  .artwork-copy {
    color: var(--ink-soft);
  }

  .artwork-copy h2 {
    color: var(--ink);
  }

  .artwork-copy .button {
    margin-top: 1rem;
  }

  .wall-scene {
    position: relative;
    min-height: clamp(34rem, 48vw, 45rem);
    overflow: hidden;
    background: #dcd7ce;
    box-shadow: inset 0 0 5rem rgba(70, 62, 52, 0.08);
  }

  .wall-frame {
    position: absolute;
    top: 10%;
    right: 17%;
    left: 17%;
    padding: 2.6%;
    background: #ede9e2;
    border: clamp(0.65rem, 1.25vw, 1.1rem) solid #282620;
    box-shadow: 0 1.5rem 2rem rgba(38, 31, 24, 0.18);
  }

  .wall-frame img {
    width: 100%;
    aspect-ratio: 1.4;
    object-fit: cover;
  }

  .wall-console {
    position: absolute;
    right: 9%;
    bottom: 12%;
    left: 9%;
    height: 1.1rem;
    background: #6c5946;
    box-shadow: 0 0.5rem 1.2rem rgba(0, 0, 0, 0.16);
  }

  .wall-console i {
    position: absolute;
    top: 100%;
    width: 0.7rem;
    height: 9rem;
    background: #6c5946;
  }

  .wall-console i:first-child { left: 6%; }
  .wall-console i:last-child { right: 6%; }

  .about-preview {
    background: var(--paper);
  }

  .about-preview__grid {
    display: grid;
    grid-template-columns: 0.78fr 1.22fr;
    align-items: center;
    gap: clamp(3rem, 10vw, 10rem);
  }

  .about-preview__image {
    position: relative;
  }

  .about-preview__image::before {
    position: absolute;
    z-index: -1;
    inset: 8% -8% -8% 8%;
    background: var(--sand);
    content: '';
  }

  .about-preview__image img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .about-preview__content {
    max-width: 41rem;
    color: var(--ink-soft);
  }

  .about-preview__content h2 {
    color: var(--ink);
  }

  .about-preview__content .button {
    margin-top: 1rem;
  }

  @media (max-width: 900px) {
    .home-hero__shade {
      background: linear-gradient(90deg, rgba(16, 22, 17, 0.82), rgba(16, 22, 17, 0.24)), linear-gradient(0deg, rgba(0, 0, 0, 0.58), transparent 60%);
    }

    .opening-grid,
    .artwork-grid,
    .about-preview__grid {
      grid-template-columns: 1fr;
    }

    .opening-copy {
      padding-top: 0;
    }

    .property-section {
      grid-template-columns: 1fr;
    }

    .property-section__content {
      padding: var(--section) var(--gutter);
    }

    .wall-scene {
      min-height: min(80vw, 42rem);
    }

    .about-preview__image {
      max-width: 35rem;
    }
  }

  @media (max-width: 760px) {
    .home-hero {
      min-height: calc(100svh - 7rem);
    }

    .home-hero__image {
      object-position: 58% center;
    }

    .home-hero__shade {
      background: linear-gradient(0deg, rgba(16, 22, 17, 0.92) 0%, rgba(16, 22, 17, 0.54) 62%, rgba(16, 22, 17, 0.15) 100%);
    }

    .home-hero__content {
      justify-content: flex-end;
      padding-bottom: 6rem;
    }

    .home-hero__caption {
      display: none;
    }

    .service-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: 36rem;
    }

    .home-gallery {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(3, 24rem);
    }

    .home-gallery__family {
      grid-column: span 2;
      grid-row: auto;
    }
  }

  @media (max-width: 520px) {
    .home-hero h1 {
      font-size: clamp(3.5rem, 16vw, 5rem);
    }

    .home-gallery {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      grid-auto-rows: 32rem;
    }

    .home-gallery__family {
      grid-column: auto;
    }

    .property-section__image {
      min-height: 30rem;
    }
  }
</style>
