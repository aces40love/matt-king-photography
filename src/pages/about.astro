---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ButtonLink from '../components/ButtonLink.astro';
import InquiryBand from '../components/InquiryBand.astro';
import ProofBar from '../components/ProofBar.astro';
import SectionIntro from '../components/SectionIntro.astro';
import headshot from '../assets/images/headshot.png';
import heroFamily from '../assets/images/hero-family.webp';
import childBoy from '../assets/images/child-boy.webp';
---

<BaseLayout
  title="About Matt King | Memphis Family Photographer"
  description="Meet Matt King, a father of three and Memphis-area family, child, and senior photographer serving West Tennessee since 2004."
>
  <section class="about-hero">
    <div class="container about-hero__grid">
      <div class="about-hero__portrait">
        <Image src={headshot} alt="Portrait photographer Matt King" widths={[560, 840, 1120]} sizes="(max-width: 820px) 100vw, 46vw" format="webp" quality={84} loading="eager" fetchpriority="high" />
      </div>
      <div>
        <p class="eyebrow">Hi, I’m Matt</p>
        <h1>I know how quickly the people in front of you change.</h1>
        <p class="lede">I am a husband, father of three, and photographer who has spent more than 20 years helping families hold onto the season they are already living.</p>
        <ButtonLink href="/contact/" label="Tell me about your family" />
      </div>
    </div>
  </section>

  <ProofBar />

  <section class="section story-section">
    <div class="container story-grid">
      <div>
        <p class="eyebrow">Why this work</p>
        <h2>Childhood never announces the last time.</h2>
      </div>
      <div class="story-copy">
        <p class="lede">The last time they ask to be carried. The last summer before senior year. The ordinary evening when everyone still lives under one roof.</p>
        <p>As a father, I know those moments usually look ordinary while they are happening. As a photographer, I know how much they will mean later.</p>
        <p>That is why my work is calm, personal, and practical. I will help with the clothing, choose light that flatters, keep the children comfortable, and show you what will work on your walls. You get to stay present.</p>
        <p class="signature">— Matt</p>
      </div>
    </div>
  </section>

  <section class="values-section">
    <div class="values-section__image"><Image src={heroFamily} alt="Family sharing a quiet moment together beside the water" widths={[720, 1080, 1440]} sizes="(max-width: 820px) 100vw, 52vw" format="webp" quality={84} loading="lazy" /></div>
    <div class="values-section__content">
      <p class="eyebrow eyebrow--light">Client focused. Jesus driven.</p>
      <h2>Serve people well. Make honest photographs. Finish the job.</h2>
      <p>The values are simple: listen before directing, earn a child’s trust, communicate clearly, and create something worthy of the family who invited me in.</p>
      <p>My job is not to make your family look like someone else’s. It is to notice what is already good and make it visible.</p>
    </div>
  </section>

  <section class="section approach-section">
    <div class="container">
      <SectionIntro eyebrow="What you can expect" title="Experience without ego." copy="A veteran photographer should make the process feel lighter, not make the room revolve around himself." />
      <div class="approach-grid">
        <article><span>01</span><h3>Plain communication</h3><p>You will know what happens next, what things cost, and how to prepare.</p></article>
        <article><span>02</span><h3>Patient direction</h3><p>No one is expected to arrive knowing how to pose or keep children perfectly still.</p></article>
        <article><span>03</span><h3>Personal design</h3><p>Your location, session pace, and finished artwork are chosen for your people and home.</p></article>
        <article><span>04</span><h3>Work that lasts</h3><p>The goal is not another trend. It is a portrait you will still want to see years from now.</p></article>
      </div>
    </div>
  </section>

  <section class="section closing-story">
    <div class="container closing-story__grid">
      <div><Image src={childBoy} alt="Young boy smiling during his portrait session" widths={[520, 760, 980]} sizes="(max-width: 820px) 100vw, 38vw" format="webp" quality={82} loading="lazy" /></div>
      <div>
        <p class="eyebrow">Based in Munford, serving home</p>
        <h2>A local studio with room to roam.</h2>
        <p>Matt King Photography is based in Historic Downtown Munford and serves families throughout Memphis, Tipton County, Shelby County, Fayette County, and the surrounding West Tennessee communities.</p>
        <p>Sessions are available by appointment at the downtown studio, on the private 10-acre portrait property, and at locations chosen around your story.</p>
        <ButtonLink href="/experience/" label="Explore the experience" variant="outline" />
      </div>
    </div>
  </section>

  <InquiryBand eyebrow="Let’s make something honest" title="Tell me who you never want to forget." />
</BaseLayout>

<style>
  .about-hero { background: var(--cream); overflow: hidden; }
  .about-hero__grid { display: grid; grid-template-columns: .9fr 1.1fr; align-items: center; min-height: min(49rem, calc(100svh - 7.75rem)); gap: clamp(3rem, 9vw, 9rem); }
  .about-hero__portrait { align-self: stretch; margin-left: calc((100vw - min(100vw - (var(--gutter) * 2), var(--container))) / -2); }
  .about-hero__portrait img { width: 100%; height: 100%; object-fit: cover; }
  .about-hero__grid > div:last-child { padding-block: 5rem; }
  .about-hero h1 { max-width: 11ch; font-size: clamp(3.8rem, 7vw, 6.6rem); }
  .about-hero .button { margin-top: 1.2rem; }

  .story-section { background: var(--paper); }
  .story-grid { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(3rem, 10vw, 10rem); }
  .story-copy { max-width: 38rem; color: var(--ink-soft); }
  .signature { margin-top: 2rem; color: var(--ink); font-family: var(--serif); font-size: 2rem; font-style: italic; }

  .values-section { display: grid; grid-template-columns: 1.08fr .92fr; min-height: 48rem; color: white; background: var(--forest); }
  .values-section__image img { width: 100%; height: 100%; object-fit: cover; }
  .values-section__content { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: clamp(4rem, 8vw, 8rem); }
  .values-section__content p:not(.eyebrow) { max-width: 34rem; color: rgba(255, 255, 255, .7); }

  .approach-section { background: var(--cream); }
  .approach-grid { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
  .approach-grid article { min-height: 20rem; padding: 2rem 2rem 2rem 0; border-right: 1px solid var(--line); }
  .approach-grid article:not(:first-child) { padding-left: 2rem; }
  .approach-grid article:last-child { border-right: 0; }
  .approach-grid span { display: block; margin-bottom: 5rem; color: var(--brass); font-size: .7rem; font-weight: 750; }
  .approach-grid p { color: var(--ink-soft); font-size: .92rem; }

  .closing-story { background: var(--paper); }
  .closing-story__grid { display: grid; grid-template-columns: .82fr 1.18fr; align-items: center; gap: clamp(3rem, 10vw, 10rem); }
  .closing-story__grid img { width: 100%; max-height: 44rem; object-fit: cover; }
  .closing-story__grid > div:last-child { max-width: 41rem; color: var(--ink-soft); }
  .closing-story__grid h2 { color: var(--ink); }
  .closing-story .button { margin-top: 1rem; }

  @media (max-width: 820px) {
    .about-hero__grid, .story-grid, .values-section, .closing-story__grid { grid-template-columns: 1fr; }
    .about-hero__portrait { min-height: 36rem; margin-inline: calc(var(--gutter) * -1); order: 2; }
    .about-hero__grid > div:last-child { order: 1; }
    .values-section__image { min-height: 34rem; }
    .approach-grid { grid-template-columns: 1fr 1fr; }
    .approach-grid article:nth-child(2) { border-right: 0; }
  }
  @media (max-width: 560px) {
    .approach-grid { grid-template-columns: 1fr; }
    .approach-grid article, .approach-grid article:not(:first-child) { min-height: auto; padding: 2rem 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .approach-grid span { margin-bottom: 2.5rem; }
  }
</style>
